# Cardputer Mic — ESP-IDF 默认配置
#
# 当前为 P0（工程骨架 + 硬件诊断）阶段的最小集合。P1/P2 接入 LVGL 与 NimBLE 时
# 再追加下方注释里的配置块；提前写入会引用尚未引入组件的 Kconfig 符号。
# 完整目标清单见 ../.context/cardputer-adv-mic-plan-a.zh_CN.md §3.3。

# --- 目标芯片 ---
# Stamp-S3A = ESP32-S3FN8，8 MB Flash、无 PSRAM。禁止启用 CONFIG_SPIRAM*。
CONFIG_IDF_TARGET="esp32s3"

# --- Flash 与分区 ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8 MB 镜像头，便于 idf.py merge-bin 生成 0x0 合并镜像。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台 ---
# 定版：完全不输出（原因见文件末尾的 console 说明块）。

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- P1（显示 / UI）待追加 ---
# CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_DEF_REFR_PERIOD=33
# CONFIG_LV_FONT_MONTSERRAT_14=y
# CONFIG_LV_MEM_SIZE_KILOBYTES=40

# --- P2（NimBLE GATT）---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# 控制写入需保留缓冲；24 块与上游一致。
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# 定版：日志编译期裁掉。console 已关闭，保留只白占 flash 与运行期格式化开销；
# 现场诊断走屏幕可视化日志（mic_ui_boot_stage），排障时临时改回 INFO + 重新烧录。
# 注意 LOG_MAXIMUM_LEVEL 没有 NONE 选项，DEFAULT=NONE 已经足够把日志全部裁掉。
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# console 完全不输出：GPIO43 已被 I2S WS 占用，UART0 console 会与之抢引脚；
# USB-Serial-JTAG console 在 app 早期写日志会卡死（实测黑屏 + BLE 不起）。
# 诊断改走屏幕可视化日志（mic_ui_boot_stage）。
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
